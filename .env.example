# ==============================================================================
# BAYARO — Environment Variables Template
# Salin file ini menjadi .env.local dan isi nilai kredensial untuk pengembangan.
# JANGAN PERNAH commit file .env atau .env.local ke repositori git!
# File .env.example ini HANYA berisi placeholder — jangan taruh nilai asli di sini.
# ==============================================================================

# ==============================================================================
# 1. Supabase Configuration (Database, Auth, Storage)
# Ambil di: Supabase -> Project Settings -> API Keys
# ==============================================================================
# URL API project Supabase Anda (bentuk: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon/Publishable key (aman diakses dari browser) -> "Publishable key" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role / Secret key (akses admin, BYPASS RLS) -> "Secret keys" (sb_secret_...)
# RAHASIA. Hanya untuk server. JANGAN beri prefix NEXT_PUBLIC_, jangan diekspos, jangan di-commit.
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# 2. Midtrans Payment Gateway (Fase lanjut - Pembayaran Snap)
# Ambil di: dashboard.midtrans.com (Environment = Sandbox) -> Settings -> Access Keys
# ==============================================================================
# Server Key Midtrans untuk pembuatan transaksi & verifikasi signature webhook
# RAHASIA. Hanya untuk server. (Sandbox diawali SB-Mid-server-...)
MIDTRANS_SERVER_KEY=

# Client Key Midtrans untuk membuka Snap popup di frontend (Sandbox: SB-Mid-client-...)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Mode Midtrans (false = Sandbox, true = Production)
MIDTRANS_IS_PRODUCTION=false

# ==============================================================================
# 3. Aplikasi & Waktu (Routing & Kuota)
# ==============================================================================
# URL root aplikasi
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Timezone penghitungan kuota harian Free (10 invoice/hari) - WIB.
# Server-only (tanpa NEXT_PUBLIC_): kuota diverifikasi di server.
APP_TIMEZONE=Asia/Jakarta

# ==============================================================================
# 4. Email (Kirim invoice ke klien) — OPSIONAL
# Ambil di: resend.com -> API Keys -> Create API Key (izin "Sending access")
# Jika dikosongkan, tombol kirim email memakai aplikasi email pengguna (mailto:).
# ==============================================================================
# RAHASIA. Hanya untuk server. (diawali re_...)
RESEND_API_KEY=

# Pengirim email. Tanpa domain terverifikasi di Resend, WAJIB memakai domain uji
# bawaan Resend dan hanya bisa mengirim ke alamat email pemilik akun Resend.
# Contoh uji      : Bayaro <onboarding@resend.dev>
# Contoh produksi : Bayaro <invoice@domainmu.com>   (domain harus diverifikasi)
EMAIL_FROM=
