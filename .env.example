# ==============================================================================
# BAYARO — Environment Variables Template
# Salin file ini menjadi .env.local dan isi nilai kredensial untuk pengembangan.
# JANGAN PERNAH commit file .env atau .env.local ke repositori git!
# ==============================================================================

# ==============================================================================
# 1. Supabase Configuration (Database, Auth, Storage)
# ==============================================================================
# URL API project Supabase Anda
NEXT_PUBLIC_SUPABASE_URL=

# Anon/Public key Supabase (aman diakses dari browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key Supabase (akses admin di backend, JANGAN diekspos ke publik)
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# 2. Aplikasi & Waktu (Quota & Routing)
# ==============================================================================
# URL root aplikasi (misal: http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# Timezone standar penghitungan kuota harian Free (10 invoice/hari)
NEXT_PUBLIC_APP_TIMEZONE=Asia/Jakarta

# ==============================================================================
# 3. Midtrans Payment Gateway (Fase 2 - Pembayaran Snap)
# ==============================================================================
# Client Key Midtrans untuk Snap popup di frontend
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Server Key Midtrans untuk pembuatan transaksi & verifikasi signature webhook
MIDTRANS_SERVER_KEY=

# Mode Midtrans (false = Sandbox, true = Production)
MIDTRANS_IS_PRODUCTION=false
